# MySQL de XAMPP: usuario root sin contraseña por defecto.
# Si le pusiste contraseña, codificala en la URL (ej: root:mi%20clave@).
DATABASE_URL="mysql://root:@localhost:3306/hotel_reservas"

PORT=3000
CLIENT_ORIGIN="http://localhost:5173"

# Generá uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="reemplazar-por-un-secreto-largo"

# true solo con HTTPS
COOKIE_SECURE=false

# console = imprime el email en la terminal | smtp = envía de verdad
MAIL_MODE=console
MAIL_FROM="Hotel Aurora <reservas@hotelaurora.test>"

# Para MAIL_MODE=smtp
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=clave

CURRENCY=PEN
